{
  "name": "react-slides",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:build": "sh docs/build.sh dist/docs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:build && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:build": "SITE_URL=http://localhost:4173/react-slides/ vite build --base=/react-slides/ && SITE_URL=http://localhost:4173/react-slides/ sh docs/build.sh dist/docs",
    "test:e2e": "playwright test",
    "test:update": "pnpm test:build && playwright test --update-snapshots",
    "test:docker": "docker compose -f docker/compose.test.yml run --rm --build test"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
